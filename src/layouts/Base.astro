---
import '../styles/global.css';
import { site, href } from '../site';
import PianoMark from '../components/PianoMark.astro';
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const nav = [['文章','blog/'],['作品','work/'],['相册','albums/'],['关于','about/']];
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="theme-color" content="#e9e3df" />
  <title>{title ? `${title} · ${site.name}` : site.name}</title>
  <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} /><link rel="canonical" href={canonical} />
  <meta property="og:title" content={title || site.name} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:locale" content="zh_CN" />
</head>
<body>
  <a class="skip-link" href="#main">跳到主要内容</a>
  <header class="site-header" data-pagefind-ignore>
    <a class="brand" href={href()} aria-label="个人博客首页"><span class="brand-symbol" aria-hidden="true"><PianoMark variant="keys" /></span><span class="brand-names"><b>{site.name}</b><small>{site.englishName}</small></span><span class="brand-dot">·</span></a>
    <nav aria-label="主导航">{nav.map(([label,path]) => <a href={href(path)} aria-current={Astro.url.pathname.startsWith(href(path)) ? 'page' : undefined}>{label}</a>)}<a class="search-link" href={href('search/')} aria-label="搜索文章"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a></nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer" data-pagefind-ignore><p>一处安静的角落，留给文字、影像与声音。</p><div><span>© {new Date().getFullYear()} {site.name}</span><a href={href('archive/')}>归档</a><a href={href('credits/')}>素材致谢</a><a href={href('about/')}>关于这里</a></div></footer>
</body>
</html>