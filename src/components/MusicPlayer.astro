---
import music from '../data/music.json';
import { defaultTrack,groupTracks } from '../piano/catalog.mjs';
const initial=defaultTrack(music);
const groups=groupTracks(music);
import { href } from '../site';
const time=(seconds:number)=>`${Math.floor(seconds/60)}:${String(Math.floor(seconds%60)).padStart(2,'0')}`;
---
<section class="music-panel" id="music-panel" aria-label="钢琴曲目播放器" tabindex="-1" hidden>
  <header><div><p class="eyebrow">PIANO / 自动演奏</p><h2>让钢琴，弹一会儿。</h2></div><button type="button" id="music-close" aria-label="收起曲目播放器">×</button></header>
  <label for="music-track" class="music-label">选择曲目 <span>{music.length} 首 · 可一起弹奏</span></label>
  <select id="music-track">{groups.map(group=><optgroup label={`${group.label} · ${group.tracks.length} 首`}>{group.tracks.map((track,index)=><option value={track.id} selected={track.id===initial.id}>{String(index+1).padStart(2,'0')} · {track.title}</option>)}</optgroup>)}</select>
  <p class="music-composer" id="music-composer">{initial.composer}</p>
  <div class="music-timeline"><input id="music-progress" type="range" min="0" max={initial.duration} step="0.1" value="0" aria-label="播放进度" aria-valuetext={`0:00 / ${time(initial.duration)}`} /><div><span id="music-elapsed">0:00</span><span id="music-duration">{time(initial.duration)}</span></div></div>
  <div class="music-actions"><button id="music-play" type="button" class="music-play" aria-label="播放所选曲目">▶ <span>播放</span></button><button id="music-stop" type="button">■ <span>停止</span></button><button id="music-loop" type="button" aria-pressed="false">↻ <span>单曲循环</span></button></div>
  <p id="music-status" class="music-status" role="status" aria-live="polite">点击播放，观看钢琴自动演奏。</p>
  <footer><span>下滑继续 · 切到后台暂停</span><a href={href('credits/#music')}>曲目来源与许可 ↗</a></footer>
</section>
<style>
.music-panel{position:fixed;z-index:30;right:5vw;bottom:112px;width:370px;max-height:calc(100svh - 140px);overflow:auto;padding:24px;border:1px solid #cfc4d2;background:#f5f1edf5;backdrop-filter:blur(16px);border-radius:16px;box-shadow:0 16px 60px #30203820;color:var(--ink);text-align:left}.music-panel[hidden]{display:none}.music-panel header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;gap:12px}.music-panel h2{font-family:var(--serif);font-size:24px;font-weight:400;margin-top:10px}.music-panel button{border:1px solid var(--line);background:#fff6;border-radius:22px;font-size:12px;padding:10px 14px}.music-panel header button{border:0;background:none;font-size:25px;line-height:1;padding:0 2px}.music-label{font-size:11px;display:flex;justify-content:space-between;gap:10px;margin-bottom:9px}.music-label span{color:var(--muted);font-size:10px}.music-panel select{display:block;width:100%;padding:12px 32px 12px 12px;border:1px solid #cfc4d2;background:#fff8;color:var(--ink);border-radius:8px;font:inherit;font-size:12px;text-overflow:ellipsis;cursor:pointer}.music-composer{color:var(--muted);font-size:11px;margin-top:10px}.music-timeline{margin:22px 0 18px}.music-timeline input{width:100%;accent-color:var(--accent);margin:0;cursor:pointer}.music-timeline>div{display:flex;justify-content:space-between;font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums;margin-top:7px}.music-actions{display:flex;align-items:center;gap:8px}.music-actions .music-play{background:var(--accent);color:#fff;border-color:var(--accent);min-width:82px}.music-actions button[aria-pressed=true]{color:var(--accent);border-color:var(--accent);background:#e5daed}.music-status{font-size:11px;line-height:1.8;min-height:38px;color:var(--muted);margin-top:16px}.music-panel footer{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line);padding-top:14px;font-size:9px;color:var(--muted)}.music-panel footer a{color:var(--accent)}@media(max-width:600px){.music-panel{left:4%;right:4%;bottom:max(12px,env(safe-area-inset-bottom));width:auto;max-height:80svh;padding:22px;border-radius:18px}.music-panel select{font-size:16px}.music-panel header{margin-bottom:20px}.music-panel h2{font-size:23px}.music-actions{gap:7px}.music-panel footer{font-size:9px}.music-panel .music-actions button{min-height:42px;padding:10px 13px}}@media(prefers-reduced-motion:reduce){.music-panel{backdrop-filter:none}}
</style>
