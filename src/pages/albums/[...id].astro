---
import Base from '../../layouts/Base.astro';
import ArticlePhotoViewer from '../../components/ArticlePhotoViewer.astro';
import { albums } from '../../lib/content';
import { href } from '../../site';
export async function getStaticPaths(){return (await albums()).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const sections = [...new Set(entry.data.images.map(image=>image.section || ''))];
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="page-shell" data-pagefind-body>
    <header class="page-header"><p class="eyebrow">GALLERY / 主题相册</p><h1 data-pagefind-meta="title">{entry.data.title}</h1><p>{entry.data.description}</p>{entry.data.demo&&<p><span class="demo-badge">示例插画 · 非个人摄影</span></p>}</header>
    {entry.data.article && <a class="text-link album-story-link" href={href(entry.data.article)}>读一读他的故事 <span aria-hidden="true">↗</span></a>}
    <div class="prose photo-album">
      {sections.map(section=><section aria-label={section || '相册照片'}>{section && <h2>{section}</h2>}<div class="gallery">{entry.data.images.filter(image=>(image.section || '')===section).map((image,index)=><figure><a class="article-photo" href={href(image.full || image.src)} data-caption={image.caption || image.alt} aria-label={`查看大图：${image.alt}`}><img src={href(image.src)} srcset={image.sources?.map(source=>`${href(source.src)} ${source.width}w`).join(', ')} sizes="(max-width:600px) 84vw, (max-width:1150px) 40vw, 470px" alt={image.alt} width={image.width} height={image.height} loading={section===sections[0] && index===0?'eager':'lazy'} /></a><figcaption>{image.caption || image.alt}</figcaption></figure>)}</div></section>)}
    </div>
    {!entry.data.images.length&&<p class="empty-state">这个相册还没有照片。</p>}
    <a class="back-link" href={href('albums/')}>← 返回相册</a>
  </div>
  <ArticlePhotoViewer />
</Base>
